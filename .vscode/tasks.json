{
  "version": "2.0.0",
  "tasks": [
    {
      // Idempotent: re-running against an existing cache is a no-op reconfigure.
      // The compiler is pinned because CMake's default pick on this machine is
      // the Clang bundled with Visual Studio, which this MSVC STL rejects
      // ("STL1000: expected Clang 20 or newer").
      "label": "cmake: configure debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}/mpsc-event-pipeline-kata/cpp",
        "-B", "${workspaceFolder}/mpsc-event-pipeline-kata/cpp/build-debug",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_CXX_COMPILER=C:/Program Files/LLVM/bin/clang++.exe"
      ],
      "problemMatcher": []
    },
    {
      "label": "cmake: build debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/mpsc-event-pipeline-kata/cpp/build-debug"
      ],
      "dependsOn": "cmake: configure debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
