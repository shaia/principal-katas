      // them. Previously this claimed gcc, which is not what builds this project.
      "name": "clang-msvc-x64",
      "compileCommands": "${workspaceFolder}/mpsc-event-pipeline-kata/cpp/build/compile_commands.json",
      "compilerPath": "C:/Program Files/LLVM/bin/clang++.exe",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-clang-x64",
      "includePath": [
        "${workspaceFolder}/mpsc-event-pipeline-kata/cpp/src",
        "${workspaceFolder}/mpsc-event-pipeline-kata/cpp/bench"
      ]
    }
  ],
  "version": 4
}
